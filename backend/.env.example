# Application
APP_NAME=3D Logo Video Generator
APP_VERSION=1.0.0
DEBUG=false

# API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=postgresql://logo3d_user:logo3d_pass@postgres:5432/logo3d

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage (MinIO/S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=logo3d
S3_REGION=us-east-1

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS={".png",".jpg",".jpeg",".svg"}

# Rendering
BLENDER_PATH=/usr/local/bin/blender
RENDER_OUTPUT_DIR=/app/outputs
TEMP_DIR=/app/temp

# Preview Settings
PREVIEW_WIDTH=854
PREVIEW_HEIGHT=480
PREVIEW_FPS=30
PREVIEW_SAMPLES=64

# Final Render Settings
RENDER_WIDTH_1080P=1920
RENDER_HEIGHT_1080P=1080
RENDER_WIDTH_4K=3840
RENDER_HEIGHT_4K=2160
RENDER_FPS=30
RENDER_SAMPLES_STANDARD=256
RENDER_SAMPLES_HIGH=512
